package lyc.compiler;

import java_cup.runtime.*;

class Parser;


// Terminals
terminal NUMERAL;
terminal INCLUDE;
terminal PUNTO;
terminal INTEGER;
terminal FLOAT;
terminal STRING;
terminal MAIN;
terminal ELSE;
terminal CORCH_ABRE;
terminal CORCH_CIERRA;
terminal ASIGNACION;
terminal PUNTO_COMA;
terminal SYS_OUT;
terminal SYS_IN;
terminal AND;
terminal OR;
terminal POINTER;
terminal BARRA;
terminal ASTERISCO;
terminal SALTO_LINEA;
terminal COMENTARIO_MULTI;
terminal COMENTARIO_SINGLE;
terminal CADENA;
terminal READ;
terminal WRITE;

terminal CTE;
terminal ID;
terminal OP_SUM;
terminal OP_MUL;
terminal OP_RES;
terminal OP_DIV;
terminal PA;
terminal PC;
terminal IF;
terminal WHILE;
terminal COMA;
terminal TEXTO;
terminal DISTINTO;
terminal NEGADO;
terminal IGUAL_IGUAL;
terminal MENOR_IGUAL;
terminal MAYOR_IGUAL;
terminal MENOR;
terminal MAYOR;
terminal LLA;
terminal LLC;
terminal CTE_REAL;
terminal INIT;
terminal SLICEANDCONCAT;
terminal NEGCALCULATION;
terminal DP;

// Non Terminals
non terminal inicial;
non terminal programa;
non terminal sentencia;
non terminal asignacion;
non terminal expresion;
non terminal factor;
non terminal termino;
non terminal ifHeader;
non terminal seleccion;
non terminal condicion;
non terminal comparacion;
non terminal comparador;
non terminal iteracion;
non terminal read;
non terminal write;
non terminal bloque_init;
non terminal decs;
non terminal dec;
non terminal listaId;
non terminal tipoDato;

// Start Symbol Definition
start with inicial;

inicial  ::= programa;
inicial  ::=         ;

programa ::= programa sentencia {: System.out.println("Regla 1"); :};
programa ::= sentencia {: System.out.println("Regla 2"); :};

sentencia ::= asignacion {: System.out.println("Regla 3"); :};
sentencia ::= seleccion {: System.out.println("sentencia ::= seleccion"); :};
sentencia ::= iteracion {: System.out.println("sentencia ::= seleccion"); :};


asignacion ::= ID ASIGNACION expresion {: System.out.println("Regla 4"); :};

iteracion 	::= 	WHILE:_while PA condicion PC LLA programa LLC {: System.out.println("WHILE:_while PA condicion PC LLA programa LLC"); :};
ifHeader   ::= 	IF PA condicion PC {: System.out.println("IF PA condicion PC"); :};

seleccion	::=		ifHeader LLA programa LLC {: System.out.println("ifHeader LLA programa LLC"); :};
seleccion	::= 	ifHeader LLA programa LLC ELSE LLA programa LLC {: System.out.println("ifHeader LLA programa LLC ELSE LLA programa LLC"); :};

condicion 	::= 	comparacion AND:op comparacion {: System.out.println("comparacion AND:op comparacion"); :};
condicion 	::= 	comparacion OR:op comparacion  {: System.out.println("comparacion OR:op comparacion"); :};
condicion	::= 	comparacion 				   {: System.out.println("comparacion"); :};

condicion 	::=		NEGADO comparacion			   {: System.out.println("NEGADO condicion"); :};
condicion	::= 	NEGADO expresion 			   {: System.out.println("NEGADO expresion"); :};

comparacion ::= 	expresion comparador expresion  {: System.out.println("expresion comparador expresion"); :};
comparador  ::= 	IGUAL_IGUAL:comp 				{: System.out.println("IGUAL_IGUAL:comp"); :};
comparador  ::= 	DISTINTO:comp 					{: System.out.println("DISTINTO:comp"); :};
comparador  ::= 	MAYOR_IGUAL:comp 				{: System.out.println("MAYOR_IGUAL:comp"); :};
comparador  ::= 	MENOR_IGUAL:comp				{: System.out.println("MENOR_IGUAL:comp"); :};
comparador  ::= 	MAYOR:comp						{: System.out.println("MAYOR:comp"); :};
comparador  ::= 	MENOR:comp						{: System.out.println("MENOR:comp"); :};

expresion ::= expresion OP_SUM factor {: System.out.println("Regla 5"); :};
expresion ::= expresion OP_RES factor {: System.out.println("Regla 6"); :};
expresion ::= factor {: System.out.println("Regla 7"); :};

factor    ::= factor OP_MUL termino {: System.out.println("Regla 8"); :};
factor    ::= factor OP_DIV termino {: System.out.println("Regla 9"); :};
factor    ::= termino;

termino   ::= CTE {: System.out.println("Regla 10"); :};
termino   ::= ID {: System.out.println("Regla 11"); :};
termino   ::= CTE_REAL {: System.out.println("Regla 12"); :};
termino   ::= PA expresion PC {: System.out.println("Regla 13"); :};
termino   ::= CADENA {: System.out.println("Regla 14"); :}; //CADENA tipo de datos

//E-S
read    ::= READ PA ID PC {: System.out.println("READ"); :};
write   ::= WRITE PA ID PC {: System.out.println("WRITE"); :};
write   ::= WRITE PA TEXTO PC {: System.out.println("WRITE"); :};

//SLICEANDCONCAT
termino ::= SLICEANDCONCAT PA expresion COMA expresion COMA expresion PC {: System.out.println("Regla SLICEANDCONCAT"); :};

//INIT - Declaracion de variables
sentencia ::= bloque_init{: System.out.println("sentencia -> bloque inicializacion"); :};
bloque_init ::= INIT LLA decs LLC{: System.out.println("bloque_init -> {declaraciones}"); :};
decs ::= dec decs{: System.out.println("recursividad de lineas de declaraciones"); :};
decs ::= dec{: System.out.println("unica linea de declaracion"); :};
dec ::= listaId DP tipoDato;
listaId ::= ID COMA listaId;
listaId ::= ID;
tipoDato ::= FLOAT;
tipoDato ::= INTEGER;
tipoDato ::= STRING;
