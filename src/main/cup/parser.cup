package lyc.compiler;

import java_cup.runtime.*;
import lyc.compiler.files.IntermediateCodeGenerator;
import lyc.compiler.symbolTable.SymbolTableGenerator;
import java.util.Stack;

class Parser;
parser code {:
    private IntermediateCodeGenerator intermediateCode = IntermediateCodeGenerator.getInstance();
    private Stack<String> pilaInit = new Stack<>();
    private Stack<Integer> pilaWhile = new Stack<>();
    private Stack<Integer> pilaIf = new Stack<>();
    private Stack<Integer> pilaElse = new Stack<>();
    //private Stack<Integer> pilaContador = new Stack<>();
    private boolean banderaPila = false;
    private Stack<String> banderaCondicion = new Stack<>();
    private Stack<Integer> pilaCond = new Stack<>();
    private Stack<String> pilaExpresion = new Stack<>();
    private Stack<String> pilaCmp = new Stack<>();
    private Stack<String> pilaCmpNeg = new Stack<>();
    private Stack<Integer> pilaSaltos = new Stack<>();
    private SymbolTableGenerator symbolTable = SymbolTableGenerator.getInstance();
    private String cmpAux = "";
    private String cmpAuxNeg = "";
    private String tipoDatoAux = "";
    private String variableNegCalc = "";
    private boolean orInit = false;
:};

// Terminals
